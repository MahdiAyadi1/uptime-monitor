# Local PostgreSQL connection (Compose will use the same variable).
DATABASE_URL=postgresql+psycopg://uptime_monitor:change-me@localhost:5432/uptime_monitor

# Replace this value before enabling write endpoints; never commit a real secret.
API_KEY=replace-with-a-long-random-value

# Empty disables webhook notifications until the alerting milestone.
ALERT_WEBHOOK_URL=

FAILURE_THRESHOLD=3
MAX_CONCURRENT_PROBES=20
DUE_TOLERANCE_SECONDS=5
MAX_REDIRECTS=0
RESPONSE_BYTES_LIMIT=1048576
RETENTION_DAYS=90
PROBE_USER_AGENT=uptime-monitor-portfolio/1.0
LOG_LEVEL=INFO
