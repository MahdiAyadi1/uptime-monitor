{
  "uid": "uptime-monitor",
  "title": "Uptime Monitor",
  "tags": ["uptime"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "monitor",
        "label": "Monitor",
        "type": "query",
        "datasource": {
          "uid": "uptime-postgres"
        },
        "query": "SELECT name FROM monitor WHERE enabled ORDER BY name",
        "definition": "SELECT name FROM monitor WHERE enabled ORDER BY name",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Monitors up",
      "type": "stat",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS up FROM monitor m JOIN LATERAL (SELECT is_up, latency_ms, http_status, tls_days_remaining, probed_at, error_message FROM probe_result WHERE monitor_id = m.id ORDER BY probed_at DESC LIMIT 1) p ON true WHERE m.enabled AND p.is_up"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Monitors down",
      "type": "stat",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS down FROM monitor m JOIN LATERAL (SELECT is_up, latency_ms, http_status, tls_days_remaining, probed_at, error_message FROM probe_result WHERE monitor_id = m.id ORDER BY probed_at DESC LIMIT 1) p ON true WHERE m.enabled AND NOT p.is_up"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Open incidents",
      "type": "stat",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS open_incidents FROM incident WHERE resolved_at IS NULL"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Uptime (selected range)",
      "type": "stat",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE p.is_up) / NULLIF(count(*), 0) AS uptime FROM probe_result p JOIN monitor m ON m.id = p.monitor_id WHERE $__timeFilter(p.probed_at) AND m.name IN ($monitor)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Current status",
      "type": "table",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.name AS \"Monitor\", m.url AS \"URL\", CASE WHEN p.is_up THEN 'UP' ELSE 'DOWN' END AS \"Status\", p.latency_ms AS \"Latency (ms)\", p.http_status AS \"HTTP\", p.tls_days_remaining AS \"TLS days left\", p.probed_at AS \"Last probe\", p.error_message AS \"Last error\" FROM monitor m LEFT JOIN LATERAL (SELECT is_up, latency_ms, http_status, tls_days_remaining, probed_at, error_message FROM probe_result WHERE monitor_id = m.id ORDER BY probed_at DESC LIMIT 1) p ON true WHERE m.enabled ORDER BY m.name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "UP": {
                        "color": "green",
                        "index": 0
                      },
                      "DOWN": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Availability timeline",
      "type": "state-timeline",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.probed_at AS time, m.name AS metric, CASE WHEN p.is_up THEN 1 ELSE 0 END AS status FROM probe_result p JOIN monitor m ON m.id = p.monitor_id WHERE $__timeFilter(p.probed_at) AND m.name IN ($monitor) ORDER BY 1"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Response time",
      "type": "timeseries",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(p.probed_at, $__interval), m.name AS metric, avg(p.latency_ms) AS latency_ms FROM probe_result p JOIN monitor m ON m.id = p.monitor_id WHERE $__timeFilter(p.probed_at) AND p.latency_ms IS NOT NULL AND m.name IN ($monitor) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "interval": "1m"
    },
    {
      "id": 8,
      "title": "Uptime per monitor (selected range)",
      "type": "bargauge",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.name AS monitor, 100.0 * avg(CASE WHEN p.is_up THEN 1 ELSE 0 END) AS uptime_pct FROM probe_result p JOIN monitor m ON m.id = p.monitor_id WHERE $__timeFilter(p.probed_at) AND m.name IN ($monitor) GROUP BY m.name ORDER BY 2"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Incidents",
      "type": "table",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.name AS \"Monitor\", CASE WHEN i.resolved_at IS NULL THEN 'OPEN' ELSE 'RESOLVED' END AS \"State\", i.opened_at AS \"Opened\", i.resolved_at AS \"Resolved\", EXTRACT(EPOCH FROM (COALESCE(i.resolved_at, now()) - i.opened_at)) AS \"Duration\", i.last_error AS \"Last error\" FROM incident i JOIN monitor m ON m.id = i.monitor_id WHERE $__timeFilter(i.opened_at) OR i.resolved_at IS NULL ORDER BY i.opened_at DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OPEN": {
                        "color": "red",
                        "index": 0
                      },
                      "RESOLVED": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "title": "TLS certificate days left",
      "type": "bargauge",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.name AS monitor, p.tls_days_remaining AS days_left FROM monitor m JOIN LATERAL (SELECT tls_days_remaining FROM probe_result WHERE monitor_id = m.id AND tls_days_remaining IS NOT NULL ORDER BY probed_at DESC LIMIT 1) p ON true WHERE m.enabled ORDER BY p.tls_days_remaining"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Probes per interval (checker activity)",
      "type": "timeseries",
      "datasource": {
        "uid": "uptime-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "uptime-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(probed_at, $__interval), count(*) AS probes FROM probe_result WHERE $__timeFilter(probed_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "1m",
      "description": "A flat line at zero means the checker timer stopped running."
    }
  ]
}
